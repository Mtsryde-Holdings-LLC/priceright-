# Database
DATABASE_URL="postgresql://user:password@localhost:5432/priceright?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# File Storage (S3-compatible)
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="priceright-uploads"
S3_REGION="us-east-1"
S3_ENDPOINT="https://s3.amazonaws.com" # Or Cloudflare R2, etc.

# Marketplace API Credentials

# Amazon MWS/SP-API
AMAZON_CLIENT_ID="your-amazon-client-id"
AMAZON_CLIENT_SECRET="your-amazon-client-secret"
AMAZON_REFRESH_TOKEN="your-amazon-refresh-token"

# Walmart Marketplace API
WALMART_CLIENT_ID="your-walmart-client-id"
WALMART_CLIENT_SECRET="your-walmart-client-secret"

# Facebook/Meta Business API
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# TikTok Shop API
TIKTOK_APP_KEY="your-tiktok-app-key"
TIKTOK_APP_SECRET="your-tiktok-app-secret"

# WhatsApp Business API
WHATSAPP_BUSINESS_ID="your-whatsapp-business-id"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"

# Shopify API
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"

# WooCommerce API
WOOCOMMERCE_CONSUMER_KEY="your-woocommerce-consumer-key"
WOOCOMMERCE_CONSUMER_SECRET="your-woocommerce-consumer-secret"

# Optional: External ML/AI Service (if using external service)
ML_API_ENDPOINT="https://your-ml-service.com/api"
ML_API_KEY="your-ml-api-key"

# Monitoring & Logging
SENTRY_DSN="your-sentry-dsn"

# Feature Flags
ENABLE_WEBHOOKS="true"
ENABLE_REAL_TIME_SYNC="false"
